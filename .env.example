BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_BASE_URL=https://api.binance.com

APP_TIMEZONE=Asia/Karachi

DAILY_SYMBOL_CAP_PERCENT=100

TRADE_AMOUNT_USDT=6

CRON_SECRET=change-me-to-a-long-random-string
CRON_TICK_SECONDS=5
CRON_LOOP_SECONDS=55
# 1 = cron can auto-buy dips AND auto-sell at profit target (default)
# 0 = sell-only mode: cron never opens new positions, only auto-sells
#     symbols already marked "holding" once they hit the profit target
CRON_AUTO_BUY=1

APP_DEBUG=1
